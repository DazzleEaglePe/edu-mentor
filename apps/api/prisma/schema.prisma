generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE

  @@map("organization_status")
}

enum RoleKey {
  PARTICIPANT
  MENTOR
  ADMIN

  @@map("role_key")
}

enum MentorCapabilityKind {
  SPECIALIST
  PEER

  @@map("mentor_capability_kind")
}

enum OleadaStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  CLOSED

  @@map("oleada_status")
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED

  @@map("enrollment_status")
}

enum ProgramPhase {
  FASE_0
  FASE_1
  FASE_2
  FINISHED

  @@map("program_phase")
}

enum SessionType {
  ONE_ON_ONE
  GROUP
  CHECKPOINT

  @@map("session_type")
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED

  @@map("session_status")
}

enum SessionPhase {
  FASE_1
  FASE_2

  @@map("session_phase")
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED

  @@map("confirmation_status")
}

enum AttendanceStatus {
  PENDING
  ATTENDED
  ABSENT

  @@map("attendance_status")
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("reschedule_request_status")
}

enum ScheduleResourceType {
  USER
  ENROLLMENT

  @@map("schedule_resource_type")
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED

  @@map("reminder_status")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  EVALUATED
  RETURNED

  @@map("submission_status")
}

enum ScanStatus {
  PENDING
  CLEAN
  REJECTED
  ERROR

  @@map("scan_status")
}


model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(160)
  slug      String             @unique @db.VarChar(80)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  users              User[]
  oleadas            Oleada[]
  auditLogs          AuditLog[]
  outboxEvents       OutboxEvent[]
  idempotencyRecords IdempotencyRecord[]

  @@map("organization")
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  email              String   @db.VarChar(254)
  normalizedEmail    String   @map("normalized_email") @db.VarChar(254)
  passwordHash       String   @map("password_hash") @db.VarChar(255)
  fullName           String   @map("full_name") @db.VarChar(160)
  sector             String?  @db.VarChar(120)
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles            UserRole[]                 @relation("UserRoleUser")
  assignedUserRoles    UserRole[]                 @relation("UserRoleAssignedBy")
  mentorProfile        MentorProfile?
  mentorAssignments    MentorAssignment[]         @relation("MentorAssignments")
  enrollments          Enrollment[]               @relation("ParticipantEnrollments")
  mentoredSessions     Session[]                  @relation("SessionMentor")
  createdSessions      Session[]                  @relation("SessionCreator")
  attendanceRecords    SessionParticipant[]       @relation("SessionAttendanceRecorder")
  requestedReschedules SessionRescheduleRequest[] @relation("RescheduleRequester")
  decidedReschedules   SessionRescheduleRequest[] @relation("RescheduleDecider")
  authSessions         AuthSession[]
  auditLogs            AuditLog[]                 @relation("AuditActor")
  evaluations          SubmissionEvaluation[]
  topCandidateSelections AssignmentTopCandidate[]

  @@unique([organizationId, normalizedEmail])
  @@index([organizationId, isActive])
  @@map("user")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  key       RoleKey  @unique
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userRoles UserRole[]

  @@map("role")
}

model UserRole {
  userId           String   @map("user_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model MentorProfile {
  userId    String   @id @map("user_id") @db.Uuid
  headline  String?  @db.VarChar(200)
  bio       String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  capabilities MentorCapability[]

  @@map("mentor_profile")
}

model MentorCapability {
  mentorProfileId String               @map("mentor_profile_id") @db.Uuid
  kind            MentorCapabilityKind
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [userId], onDelete: Restrict)

  @@id([mentorProfileId, kind])
  @@map("mentor_capability")
}

model Oleada {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(160)
  sector         String       @db.VarChar(120)
  status         OleadaStatus @default(DRAFT)
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  capacity       Int
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enrollments       Enrollment[]
  mentorAssignments MentorAssignment[]
  sessions          Session[]
  assignments       Assignment[]

  @@index([organizationId, status])
  @@map("oleada")
}

model Enrollment {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  oleadaId          String           @map("oleada_id") @db.Uuid
  status            EnrollmentStatus @default(ACTIVE)
  currentPhase      ProgramPhase     @default(FASE_0) @map("current_phase")
  currentWeek       Int?             @map("current_week")
  phase1GraduatedAt DateTime?        @map("phase_1_graduated_at") @db.Timestamptz(3)
  enrolledAt        DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User                 @relation("ParticipantEnrollments", fields: [userId], references: [id], onDelete: Restrict)
  oleada              Oleada               @relation(fields: [oleadaId], references: [id], onDelete: Restrict)
  mentorAssignments   MentorAssignment[]
  sessionParticipants SessionParticipant[]
  deliverables        Deliverable[]

  @@unique([userId, oleadaId])
  @@index([oleadaId, status, currentPhase])
  @@map("enrollment")
}

model MentorAssignment {
  id           String               @id @default(uuid()) @db.Uuid
  mentorUserId String               @map("mentor_user_id") @db.Uuid
  oleadaId     String               @map("oleada_id") @db.Uuid
  enrollmentId String?              @map("enrollment_id") @db.Uuid
  capability   MentorCapabilityKind
  startsAt     DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?            @map("ends_at") @db.Timestamptz(3)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentor     User        @relation("MentorAssignments", fields: [mentorUserId], references: [id], onDelete: Restrict)
  oleada     Oleada      @relation(fields: [oleadaId], references: [id], onDelete: Restrict)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([mentorUserId, oleadaId, endsAt])
  @@index([enrollmentId, endsAt])
  @@map("mentor_assignment")
}

model Session {
  id                   String        @id @default(uuid()) @db.Uuid
  oleadaId             String        @map("oleada_id") @db.Uuid
  mentorUserId         String        @map("mentor_user_id") @db.Uuid
  createdByUserId      String        @map("created_by_user_id") @db.Uuid
  title                String        @db.VarChar(160)
  description          String?
  type                 SessionType
  phase                SessionPhase
  weekNumber           Int?          @map("week_number")
  checkpointMonth      Int?          @map("checkpoint_month")
  startsAt             DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime      @map("ends_at") @db.Timestamptz(3)
  timezone             String        @db.VarChar(64)
  confirmationClosesAt DateTime      @map("confirmation_closes_at") @db.Timestamptz(3)
  meetingUrl           String?       @map("meeting_url") @db.VarChar(2048)
  status               SessionStatus @default(SCHEDULED)
  version              Int           @default(1)
  rescheduledFromId    String?       @unique @map("rescheduled_from_id") @db.Uuid
  rescheduleReason     String?       @map("reschedule_reason") @db.VarChar(1000)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  oleada                    Oleada                     @relation(fields: [oleadaId], references: [id], onDelete: Restrict)
  mentor                    User                       @relation("SessionMentor", fields: [mentorUserId], references: [id], onDelete: Restrict)
  createdBy                 User                       @relation("SessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants              SessionParticipant[]
  reservations              ScheduleReservation[]
  rescheduleRequests        SessionRescheduleRequest[] @relation("RescheduleRequestSession")
  approvedRescheduleRequest SessionRescheduleRequest?  @relation("RescheduleReplacement")
  reminders                 SessionReminder[]
  rescheduledFrom           Session?                   @relation("SessionReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  replacement               Session?                   @relation("SessionReschedule")

  @@index([oleadaId, status, startsAt])
  @@index([mentorUserId, startsAt])
  @@map("session")
}

model SessionParticipant {
  sessionId              String             @map("session_id") @db.Uuid
  enrollmentId           String             @map("enrollment_id") @db.Uuid
  confirmationStatus     ConfirmationStatus @default(PENDING) @map("confirmation_status")
  confirmedAt            DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  attendanceStatus       AttendanceStatus   @default(PENDING) @map("attendance_status")
  attendanceRecordedAt   DateTime?          @map("attendance_recorded_at") @db.Timestamptz(3)
  attendanceRecordedById String?            @map("attendance_recorded_by") @db.Uuid
  version                Int                @default(1)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  session              Session    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrollment           Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  attendanceRecordedBy User?      @relation("SessionAttendanceRecorder", fields: [attendanceRecordedById], references: [id], onDelete: SetNull)

  @@id([sessionId, enrollmentId])
  @@index([enrollmentId, sessionId])
  @@map("session_participant")
}

model SessionRescheduleRequest {
  id                   String                  @id @default(uuid()) @db.Uuid
  sessionId            String                  @map("session_id") @db.Uuid
  requestedByUserId    String                  @map("requested_by_user_id") @db.Uuid
  proposedStartsAt     DateTime?               @map("proposed_starts_at") @db.Timestamptz(3)
  reason               String                  @db.VarChar(1000)
  status               RescheduleRequestStatus @default(PENDING)
  decidedByUserId      String?                 @map("decided_by_user_id") @db.Uuid
  decisionReason       String?                 @map("decision_reason") @db.VarChar(1000)
  replacementSessionId String?                 @unique @map("replacement_session_id") @db.Uuid
  requestedAt          DateTime                @default(now()) @map("requested_at") @db.Timestamptz(3)
  version              Int                     @default(1)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  session            Session  @relation("RescheduleRequestSession", fields: [sessionId], references: [id], onDelete: Restrict)
  requestedBy        User     @relation("RescheduleRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy          User?    @relation("RescheduleDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  replacementSession Session? @relation("RescheduleReplacement", fields: [replacementSessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, status, requestedAt])
  @@index([requestedByUserId, status, requestedAt])
  @@map("session_reschedule_request")
}

model ScheduleReservation {
  id           String               @id @default(uuid()) @db.Uuid
  sessionId    String               @map("session_id") @db.Uuid
  resourceType ScheduleResourceType @map("resource_type")
  resourceId   String               @map("resource_id") @db.Uuid
  startsAt     DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime             @map("ends_at") @db.Timestamptz(3)
  releasedAt   DateTime?            @map("released_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, releasedAt])
  @@index([resourceType, resourceId, releasedAt])
  @@map("schedule_reservation")
}

model SessionReminder {
  id                String         @id @default(uuid()) @db.Uuid
  sessionId         String         @map("session_id") @db.Uuid
  channel           String         @db.VarChar(40)
  sendAt            DateTime       @map("send_at") @db.Timestamptz(3)
  status            ReminderStatus @default(PENDING)
  attemptCount      Int            @default(0) @map("attempt_count")
  idempotencyKey    String         @unique @map("idempotency_key") @db.VarChar(180)
  providerMessageId String?        @map("provider_message_id") @db.VarChar(255)
  lastErrorCode     String?        @map("last_error_code") @db.VarChar(120)
  lockedAt          DateTime?      @map("locked_at") @db.Timestamptz(3)
  lockExpiresAt     DateTime?      @map("lock_expires_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([status, sendAt])
  @@index([sessionId, status])
  @@map("session_reminder")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipHash           String?   @map("ip_hash") @db.VarChar(128)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy AuthSession? @relation("AuthSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   AuthSession? @relation("AuthSessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamilyId])
  @@map("auth_session")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String   @map("entity_id") @db.Uuid
  beforeData     Json?    @map("before")
  afterData      Json?    @map("after")
  traceId        String   @map("trace_id") @db.VarChar(64)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([traceId])
  @@map("audit_log")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  aggregateType  String    @map("aggregate_type") @db.VarChar(100)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(160)
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attemptCount   Int       @default(0) @map("attempt_count")
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(180)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([publishedAt, occurredAt])
  @@index([organizationId, aggregateType, aggregateId])
  @@map("outbox_event")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  operation      String   @db.VarChar(120)
  keyHash        String   @map("key_hash") @db.Char(64)
  requestHash    String   @map("request_hash") @db.Char(64)
  resourceId     String?  @map("resource_id") @db.Uuid
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, operation, keyHash])
  @@index([expiresAt])
  @@map("idempotency_record")
}

model Assignment {
  id           String   @id @default(uuid()) @db.Uuid
  oleadaId     String   @map("oleada_id") @db.Uuid
  title        String   @db.VarChar(200)
  instructions String   @db.Text
  weekNumber   Int      @map("week_number")
  dueAt        DateTime @map("due_at") @db.Timestamptz(3)
  maxScore     Int      @default(100) @map("max_score")
  isActive     Boolean  @default(true) @map("is_active")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  oleada         Oleada                      @relation(fields: [oleadaId], references: [id], onDelete: Restrict)
  rubricCriteria AssignmentRubricCriterion[]
  deliverables   Deliverable[]
  topCandidates  AssignmentTopCandidate[]

  @@index([oleadaId, weekNumber])
  @@map("assignment")
}

model AssignmentRubricCriterion {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  key          String @db.VarChar(60)
  label        String @db.VarChar(120)
  description  String @db.VarChar(1000)
  maxScore     Int    @map("max_score")
  sortOrder    Int    @default(0) @map("sort_order")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, key])
  @@map("assignment_rubric_criterion")
}

model Deliverable {
  id                  String   @id @default(uuid()) @db.Uuid
  assignmentId        String   @map("assignment_id") @db.Uuid
  enrollmentId        String   @map("enrollment_id") @db.Uuid
  currentSubmissionId String?  @unique @map("current_submission_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignment        Assignment              @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  enrollment        Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  currentSubmission DeliverableSubmission?  @relation("DeliverableCurrentSubmission", fields: [currentSubmissionId], references: [id], onDelete: SetNull)
  submissions       DeliverableSubmission[] @relation("DeliverableSubmissions")

  @@unique([assignmentId, enrollmentId])
  @@map("deliverable")
}

model DeliverableSubmission {
  id                   String           @id @default(uuid()) @db.Uuid
  deliverableId        String           @map("deliverable_id") @db.Uuid
  revisionNumber       Int              @default(1) @map("revision_number")
  previousSubmissionId String?          @unique @map("previous_submission_id") @db.Uuid
  status               SubmissionStatus @default(DRAFT)
  notes                String           @db.Text
  submittedAt          DateTime?        @map("submitted_at") @db.Timestamptz(3)
  version              Int              @default(1)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliverable        Deliverable             @relation("DeliverableSubmissions", fields: [deliverableId], references: [id], onDelete: Restrict)
  currentDeliverable Deliverable?            @relation("DeliverableCurrentSubmission")
  previousSubmission DeliverableSubmission?  @relation("SubmissionRevisionHistory", fields: [previousSubmissionId], references: [id], onDelete: SetNull)
  nextSubmission     DeliverableSubmission?  @relation("SubmissionRevisionHistory")
  files              SubmissionFile[]
  evaluation         SubmissionEvaluation?
  topCandidates      AssignmentTopCandidate[]

  @@unique([deliverableId, revisionNumber])
  @@map("deliverable_submission")
}

model SubmissionFile {
  id               String     @id @default(uuid()) @db.Uuid
  submissionId     String     @map("submission_id") @db.Uuid
  originalName     String     @map("original_name") @db.VarChar(255)
  storageKey       String     @map("storage_key") @db.VarChar(500)
  detectedMimeType String     @map("detected_mime_type") @db.VarChar(120)
  sizeBytes        Int        @map("size_bytes")
  scanStatus       ScanStatus @default(PENDING) @map("scan_status")
  uploadedAt       DateTime   @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  submission DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_file")
}

model SubmissionEvaluation {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @unique @map("submission_id") @db.Uuid
  mentorUserId String   @map("mentor_user_id") @db.Uuid
  score        Int
  feedback     String   @db.Text
  evaluatedAt  DateTime @default(now()) @map("evaluated_at") @db.Timestamptz(3)

  submission   DeliverableSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mentor       User                    @relation(fields: [mentorUserId], references: [id], onDelete: Restrict)
  rubricScores EvaluationRubricScore[]

  @@map("submission_evaluation")
}

model EvaluationRubricScore {
  id           String  @id @default(uuid()) @db.Uuid
  evaluationId String  @map("evaluation_id") @db.Uuid
  criterionKey String  @map("criterion_key") @db.VarChar(60)
  score        Int
  comment      String? @db.VarChar(1000)

  evaluation SubmissionEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionKey])
  @@map("evaluation_rubric_score")
}

model AssignmentTopCandidate {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  rank         Int
  selectedAt   DateTime @default(now()) @map("selected_at") @db.Timestamptz(3)
  selectedById String   @map("selected_by_id") @db.Uuid

  assignment Assignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  selectedBy User                  @relation(fields: [selectedById], references: [id], onDelete: Restrict)

  @@unique([assignmentId, rank])
  @@unique([assignmentId, submissionId])
  @@map("assignment_top_candidate")
}

