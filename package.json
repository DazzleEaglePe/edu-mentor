{
  "name": "@edu-mentor/root",
  "version": "0.0.0",
  "private": true,
  "description": "EDU-MENTOR modular monolith workspace",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "pnpm generate && pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm contracts:lint && pnpm typecheck && pnpm test && pnpm build",
    "contracts:lint": "REDOCLY_TELEMETRY=off redocly lint docs/api/openapi.yaml --extends=minimal",
    "dev:api": "pnpm --filter @edu-mentor/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm -r --if-present generate",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm generate && pnpm --filter @edu-mentor/shared-types build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.40.0",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.11",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
